<?xml version="1.0" encoding="UTF-8"?>

<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd">  
  
  <qos_library name="Qos">

    <qos_profile name="State" base_name="BuiltinQosLib::Generic.KeepLastReliable.TransientLocal"/>
    <qos_profile name="Command" base_name="BuiltinQosLib::Generic.StrictReliable">
        <datawriter_qos>
            <ownership>
                <kind>EXCLUSIVE_OWNERSHIP_QOS</kind>
            </ownership>
        </datawriter_qos>
        <datareader_qos>
            <ownership>
                <kind>EXCLUSIVE_OWNERSHIP_QOS</kind>
            </ownership>
        </datareader_qos>
    </qos_profile>
    <qos_profile name="Event" base_name="BuiltinQosLib::Generic.KeepLastReliable">
        <datawriter_qos>
            <history>
                <depth>5</depth>
            </history>
        </datawriter_qos>
        <datareader_qos>
            <history>
                <depth>5</depth>
            </history>
        </datareader_qos>
    </qos_profile>
    <qos_profile name="Stream" base_name="BuiltinQosLib::Generic.BestEffort">
        <base_name>
            <element>BuiltinQosSnippetLib::QosPolicy.History.KeepLast_1</element>
        </base_name>
    </qos_profile>

    <qos_profile name="Auto" base_name="BuiltinQosLib::Generic.Common" is_default_qos="true">
        <datawriter_qos topic_filter="State"    base_name="Qos::State"/>
        <datareader_qos topic_filter="State"    base_name="Qos::State"/>
        <datawriter_qos topic_filter="Command"  base_name="Qos::Command"/>
        <datareader_qos topic_filter="Command"  base_name="Qos::Command"/>
        <datawriter_qos topic_filter="Alert"    base_name="Qos::Event"/>
        <datareader_qos topic_filter="Alert"    base_name="Qos::Event"/>
        <datawriter_qos topic_filter="Position" base_name="Qos::Stream"/>
        <datareader_qos topic_filter="Position" base_name="Qos::Stream"/>
    </qos_profile>

    <qos_profile name="Default" base_name="Qos::Auto" is_default_qos="true" is_default_participant_factory_profile="true">
        <participant_factory_qos>
            <entity_factory>
                <autoenable_created_entities>false</autoenable_created_entities>
            </entity_factory>
        </participant_factory_qos>
    </qos_profile>

  </qos_library>
</dds>